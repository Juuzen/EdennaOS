{
	"name": "@edenna/os",
	"productName": "Edenna OS",
	"version": "0.1.0",
	"description": "Edenna OS — finto sistema operativo aziendale per il LARP Frattura, in modalità kiosk.",
	"private": true,
	"license": "UNLICENSED",
	"author": "Juuzen",
	"homepage": "https://github.com/Juuzen/EdennaOS",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Juuzen/EdennaOS.git",
		"directory": "edenna"
	},
	"desktopName": "edenna-os.desktop",
	"type": "module",
	"main": "dist/electron/main.cjs",
	"scripts": {
		"dev": "vite",
		"dev:electron": "pnpm run build:electron && concurrently -k -n web,app \"vite --strictPort\" \"wait-on tcp:3000 && cross-env EDENNA_DEV_URL=http://localhost:3000 EDENNA_WINDOWED=1 electron .\"",
		"typecheck": "tsc --noEmit && tsc --noEmit -p electron",
		"build:electron": "tsc -p electron",
		"build:web": "tsc --noEmit && vite build",
		"build": "pnpm run build:electron && pnpm run build:web",
		"start": "electron .",
		"start:windowed": "cross-env EDENNA_WINDOWED=1 electron .",
		"dist": "pnpm run build && electron-builder --linux",
		"dist:deb": "pnpm run build && electron-builder --linux deb",
		"dist:appimage": "pnpm run build && electron-builder --linux AppImage",
		"preview": "vite preview"
	},
	"//": "Tutte le dipendenze sono devDependencies: Vite le include nel bundle di dist/, quindi electron-builder non deve copiare nessun node_modules nel pacchetto.",
	"devDependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"@prozilla-os/core": "workspace:*",
		"@prozilla-os/file-explorer": "workspace:*",
		"@prozilla-os/shared": "workspace:*",
		"@prozilla-os/skins": "workspace:*",
		"@prozilla-os/text-editor": "workspace:*",
		"@types/node": "^22.0.0",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"concurrently": "^9.2.1",
		"cross-env": "^7.0.3",
		"electron": "45.2.3",
		"electron-builder": "^26.18.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"wait-on": "^8.0.5"
	}
}
