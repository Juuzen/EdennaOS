{
	// Processo principale di Electron: CommonJS per Node.js, compilato in ../dist/electron.
	"compilerOptions": {
		"target": "ES2023",
		"module": "Node16",
		"moduleResolution": "Node16",
		"types": ["node"],
		"outDir": "../dist/electron",
		"rootDir": ".",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["*.cts"]
}
